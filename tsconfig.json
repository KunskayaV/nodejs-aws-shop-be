{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./build",  // Output directory for JavaScript files
    "rootDir": "./src",   // Root directory for TypeScript files
    "lib": ["ES2020"],
    "strict": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["cdk", "node_modules", "**/*.spec.ts"]
}