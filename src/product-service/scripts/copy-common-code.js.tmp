const fs = require('fs-extra');
const path = require('path');

const functions = [
  'getProductsList',
  'createNewProduct',
  'getProductById'
];

const srcPath = path.join(__dirname, '../src/common');
functions.forEach(func => {
  const destPath = path.join(__dirname, `../src/product-service/${func}/common`);
  
  // Check if the destination path exists and remove it if it does
  if (fs.existsSync(destPath)) {
    fs.removeSync(destPath);
  }

  // Copy the common directory to the function's directory
  fs.copySync(srcPath, destPath);
});