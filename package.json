{
  "name": "nodejs-aws-shop-be",
  "version": "0.1.0",
  "bin": {
    "nodejs-aws-shop-be": "bin/nodejs-aws-shop-be.js"
  },
  "scripts": {
    "build": "npm run build:lambda",
    "build:lambda": "cd src/import-service && npm install && npm run build",
    "test": "jest",
    "cdk:start": "cdk",
    "cdk:deploy-dev": "npm run build && cdk deploy --all --hotswap",
    "cdk:deploy": "cdk deploy --all",
    "cdk:deploy:product": "cdk deploy rs-toy-shop-be-stack",
    "cdk:deploy:import": "cdk deploy rs-toy-shop-be-import-stack",
    "cdk:destroy": "cdk destroy",
    "cdk:bootstrap": "cdk bootstrap",
    "cdk:diff": "cdk diff",
    "script:dynamodb": "node -r dotenv/config src/product-service/scripts/fillDynamoDB.js",
    "test:lambda": "echo '{\"queryStringParameters\":{\"name\":\"products.csv\"}}' | sam local invoke --event - import-products-file-lambda-dev -t ./cdk.out/rs-toy-shop-be-import-stack.template.json",
    "test:lambda-import": "sam local invoke --event ./event.json import-file-parser-lambda-dev -t ./cdk.out/rs-toy-shop-be-import-stack.template.json",
    "test:lambda-product": "sam local invoke --event ./event-sqs.json catalog-batch-process-dev --no-event -t ./cdk.out/rs-toy-shop-be-stack.template.json",
    "cdk:synth": "cdk synth --all --no-staging"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "22.7.9",
    "aws-cdk": "^2.1000.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.179.0",
    "constructs": "^10.4.2",
    "dotenv": "^16.4.7"
  }
}
