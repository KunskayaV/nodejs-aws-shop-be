{
  "name": "nodejs-aws-shop-be",
  "version": "0.1.0",
  "bin": {
    "nodejs-aws-shop-be": "bin/nodejs-aws-shop-be.js"
  },
  "scripts": {
    "build": "npm run build:lambda",
    "build:lambda": "cd src/product-service && npm install && npm run build",
    "test": "jest",
    "cdk:start": "cdk",
    "cdk:deploy-dev": "npm run build && cdk deploy --hotswap",
    "cdk:deploy": "cdk deploy",
    "cdk:destroy": "cdk destroy",
    "cdk:bootstrap": "cdk bootstrap",
    "cdk:diff": "cdk diff",
    "script:dynamodb": "node -r dotenv/config src/product-service/scripts/fillDynamoDB.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "22.7.9",
    "aws-cdk": "^2.1000.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.179.0",
    "constructs": "^10.4.2",
    "dotenv": "^16.4.7"
  }
}
